# EditorConfig keeps whitespace identical on both machines, so a file edited on
# the laptop does not come back from the desktop with a reindented diff.
# PhpStorm reads this natively; no plugin is required.
# https://editorconfig.org
root = true

# Defaults for every file. Both machines run Ubuntu, so LF and UTF-8 without a
# BOM are the only sensible choices. The final newline is what POSIX tools
# expect from a text file, and what keeps diffs from showing a "\ No newline at
# end of file" marker. Two spaces because that is what every indented file in
# this repository already uses, tab-indented git config aside.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown. Two trailing spaces are a hard line break, so trailing whitespace
# has to survive here: trimming it silently changes the rendered document.
[*.md]
trim_trailing_whitespace = false

# Shell and zsh scripts. Two spaces to match zsh/zshrc.sh as written, and
# because shell nests quickly (a case inside an if inside a function) where a
# wider indent pushes lines out of reach for no readability gain.
[*.sh]
indent_style = space
indent_size = 2

# git config files. Git writes section bodies with a leading tab and
# git/gitconfig follows that convention, so anything git itself rewrites stays
# consistent with what is already committed.
[{gitconfig,.gitconfig,gitconfig-*,.gitmodules}]
indent_style = tab

# JSON. Two spaces, matching docker/daemon.json.
[*.json]
indent_style = space
indent_size = 2

# dconf exports. Generated by `dconf dump`, INI-shaped and never indented. Do
# not hand-reformat one: the next export overwrites the file wholesale.
[*.dconf]
indent_style = space
indent_size = 2

# Extensionless client configs (ssh/config), whose blocks are indented one
# level under their Host line.
[config]
indent_style = space
indent_size = 2

# Verbatim MIT text. Nothing here should be reflowed or reindented; the only
# rule that matters is that it still ends with a newline.
[LICENSE]
indent_style = unset
indent_size = unset
max_line_length = off

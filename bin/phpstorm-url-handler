#!/usr/bin/env bash
#
# Open phpstorm://open?url=file://<file>&line=<n> links in PhpStorm.
#
# Registered as the handler for the phpstorm:// and pstorm:// schemes by
# install.sh, so a file:line link in a stack trace, an Xdebug error page or a CI
# log opens at the right line.
#
# Written here instead of using sanduhrs/phpstorm-url-handler, which no longer
# works: it calls `phpstorm --line N file`, and the current launcher rejects
# --line unless a project directory comes first. It also raises the window with
# wmctrl, which only reaches an IDE running on XWayland; see below.
#
set -uo pipefail

# The desktop file cannot rely on the session PATH: it contains neither
# ~/.local/bin nor the JetBrains Toolbox scripts directory.
PHPSTORM="${PHPSTORM:-$HOME/.local/share/JetBrains/Toolbox/scripts/phpstorm}"

# A click that silently does nothing is the failure mode of every URL handler,
# and a browser gives no output to look at. This is where to look.
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/phpstorm-url-handler.log"

log() {
  mkdir -p -- "$(dirname -- "$LOG")"
  printf '%s  %s\n' "$(date -Is)" "$*" >>"$LOG"
}

die() {
  log "ERROR: $*"
  # notify-send so a failed click says something instead of nothing.
  command -v notify-send >/dev/null &&
    notify-send -u critical "PhpStorm URL handler" "$*"
  exit 1
}

url="${1:-}"
[[ -n "$url" ]] || die "no URL given"
log "url: $url"

# Under Wayland the IDE can only raise its window if it is handed an activation
# token minted by the compositor for the click that started this. The browser
# has to pass it down in XDG_ACTIVATION_TOKEN; a browser that shells out to
# xdg-open loses it, and then the file opens behind the browser and the click
# looks like it did nothing. Logged because it is the difference between "the
# browser is not cooperating" and "the IDE is ignoring the token".
log "activation token: ${XDG_ACTIVATION_TOKEN:-<none>} | startup id: ${DESKTOP_STARTUP_ID:-<none>}"

# %XX unescaping. The URL arrives from a browser, so a path with a space is
# %20 and any of the pattern characters below could be escaped.
url="${url//+/ }"
printf -v url '%b' "${url//%/\\x}" 2>/dev/null || die "cannot decode: $1"

# The four forms upstream accepted:
#   phpstorm://open?url=file://<file>&line=<n>
#   phpstorm://open?file=<file>&line=<n>
#   phpstorm://open?url=file://<file>:<n>
#   phpstorm://open?file=<file>:<n>
pattern='.*file(://|=)(.*)(:|&line=)(.*)'
if [[ "$url" =~ $pattern ]]; then
  file="${BASH_REMATCH[2]}"
  line="${BASH_REMATCH[4]}"
else
  # No line number at all, just a file.
  file="${url#*file://}"
  file="${file#*file=}"
  file="${file%%&*}"
  line=1
fi

# Anything not a digit is not a line number. The value comes from a web page.
line="${line//[^0-9]/}"
: "${line:=1}"

[[ -n "$file" ]] || die "no file in URL: $1"
[[ "$file" == /* ]] || die "not an absolute path: $file"
[[ -f "$file" ]] || die "file does not exist: $file"
[[ -x "$PHPSTORM" ]] || die "phpstorm launcher not found at $PHPSTORM"

# The launcher needs the project directory before --line, so find the innermost
# one containing the file: .idea is PhpStorm's own project marker, and a git
# root is the best guess when the project has never been opened.
project=""
dir="$(dirname -- "$(readlink -f -- "$file")")"
while [[ "$dir" != / ]]; do
  if [[ -d "$dir/.idea" ]]; then project="$dir"; break; fi
  [[ -z "$project" && -e "$dir/.git" ]] && project="$dir"
  dir="$(dirname -- "$dir")"
done
: "${project:=$(dirname -- "$file")}"

# Raising the window is a separate problem from opening the file, and the harder
# one. Under Wayland a background app cannot raise itself without an activation
# token minted for the originating click, and a browser that reaches this script
# through xdg-open has already lost it: the file opens behind the browser and the
# click reads as doing nothing. GNOME offers no way out either — org.gnome.Shell
# exposes no window activation and Eval is disabled.
#
# So the IDE runs on XWayland (-Dawt.toolkit.name=XToolkit in phpstorm64.vmoptions)
# and this asks mutter to activate it. wmctrl requests as a pager, and mutter
# honours pager requests unconditionally, with no token involved.
#
# Raised before the open request rather than after it, so the script still ends
# in a single exec: the window comes up and the file lands in it a moment later.
# With no IDE running there is nothing to raise and the fresh window takes focus
# on its own, so a failure here is not worth reporting to the user.
if command -v wmctrl >/dev/null; then
  wmctrl -x -a jetbrains-phpstorm || log "no PhpStorm window to raise yet"
else
  log "wmctrl not installed, the window will open without being raised"
fi

log "opening $file:$line in project $project"
exec "$PHPSTORM" "$project" --line "$line" "$file"
